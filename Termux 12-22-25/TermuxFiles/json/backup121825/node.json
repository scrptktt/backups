    "New-Event": {
        "summary": "Get all events",
        "example.new-event.1": {
            "description": "uses a Windows.Timer object to send the event (create new event).",
            "1": "New-Event -SourceIdentifier Timer -Sender Windows.Timer -MessageData \"Test\""
        },
        "example.new-event.2": {
            "description": "Get an event based on the time it was generated",
            "script": "Enable-ProcessCreationEvent.ps1"
        },
        "link": "https://learn.microsoft.com/pdf?url=https%3A%2F%2Flearn.microsoft.com%2Fen-us%2Fpowershell%2Fmodule%2Fpsdocs%2Ftoc.json%3Fview%3Dpowershell-7.5#page=4516&zoom=100,36,36"
    },
    "Get-Event": {
        "summary": "Get all events",
        "example.get-event.1": {
            "description": "Get events by source identifier",
            "1": "Get-Event -SourceIdentifier \"PowerShell.ProcessCreated\""
        },
        "example.get-event.2": {
            "description": "Get an event based on the time it was generated",
            "1": "$Events = Get-Event",
            "2": "$Events[0] | Format-List -Property *",
            "oneline": "$Events = Get-Event; $Events[0] | Format-List -Property *"
        },
        "example.get-event.3": {
            "description": "Get an event by its identifier",
            "1": "Get-Event -EventIdentifier 2"
        },
